{
  "name": "@zalib/devkit",
  "version": "5.9.9",
  "description": "DevKIT package",
  "license": "UNLICENSED",
  "engines": {
    "node": "^22.22.3",
    "npm": "^10.9.8"
  },
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./eslint": {
      "default": "./dist/eslint/index.js",
      "types": "./dist/eslint/index.d.ts"
    },
    "./prettier": {
      "default": "./dist/prettier/index.js",
      "types": "./dist/prettier/index.d.ts"
    },
    "./stylelint": {
      "default": "./dist/stylelint/index.js",
      "types": "./dist/stylelint/index.d.ts"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wsp-repo/devkit.git"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rimraf dist",
    "format": "prettier --write 'src/**/*.{js,ts,json,md}'",
    "lint": "eslint ./src --quiet",
    "lint:fix": "eslint ./src --fix",
    "prebuild": "rimraf dist",
    "prepublishOnly": "npm run lint && npm run build",
    "release:major": "npm version major",
    "release:minor": "npm version minor",
    "release:patch": "npm version patch",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "16.2.7",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-fsd-lint": "1.2.1",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-perfectionist": "5.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.5",
    "prettier": "3.8.3",
    "rimraf": "^6.1.3",
    "stylelint": "17.12.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.60.0",
    "vitest": "^4.1.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.1"
  },
  "peerDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "package.json": "check-exact-package",
    "*.{js,ts}": [
      "eslint --quiet --max-warnings 0",
      "eslint --quiet --fix",
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged --allow-empty"
    }
  }
}
